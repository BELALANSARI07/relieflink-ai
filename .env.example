# ============================================================================
# ReliefLink AI — Environment Variables Configuration
# ============================================================================

# Database (PostgreSQL with PostGIS)
DATABASE_URL="postgresql://relieflink:relieflink_secret@localhost:5432/relieflink_db?schema=public"

# NextAuth / Session Secret (Generated secret for JWT signing)
NEXTAUTH_SECRET="relieflink-production-super-secret-key-32chars"
NEXTAUTH_URL="http://localhost:3000"

# Google Gemini API Key (Multimodal AI & Decision Support)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"

# Application Environment
NODE_ENV="development"
PORT=3000

# Emergency Notification Webhooks (Optional)
SMS_GATEWAY_API_KEY=""
NDMA_GATEWAY_URL=""
